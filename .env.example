# The variables this Worker reads. On Cloudflare Workers they are NOT read from
# a `.env` file — there is no `process.env` at runtime. Each one reaches the
# Worker as a binding on the `env` argument of `fetch`:
#
#   local dev  -> copy `.dev.vars.example` to `.dev.vars`
#   deployed   -> `wrangler secret put MAILTEA_API_KEY` for the key,
#                 `[vars]` in `wrangler.toml` for the rest
#
# This file is the canonical list; it is not loaded by anything.

MAILTEA_API_KEY=mt_pat_your_key_here
MAILTEA_FROM=Acme <hello@acme.com>

# Optional. Overrides the API host, which defaults to https://api.mailtea.app.
# MAILTEA_API_BASE_URL=https://api.mailtea.app
